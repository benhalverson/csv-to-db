{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (console) with data",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/cli-dotnet.dll",
      "args": [
        "--db=cosmos",
        "--data=data/data.csv"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "internalConsoleOptions": "neverOpen"
    }
  ]
}